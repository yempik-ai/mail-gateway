{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install",
  "buildCommand": "pnpm -r build",
  "framework": null,
  "functions": {
    "api/index.ts": { "maxDuration": 60, "includeFiles": "migrations/**" }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }]
}
