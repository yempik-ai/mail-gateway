# Runtime
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
# fatal, error, warn, info, debug, trace or silent.
LOG_LEVEL=info
# Behind a load balancer or reverse proxy (self-hosted): true, a hop count, or comma-separated proxy CIDRs.
TRUST_PROXY=false
# PostgreSQL connection string. With Neon, use the DIRECT connection string of
# a development branch locally, and the pooled one only on Vercel in production.
DATABASE_URL=postgresql://user:password@ep-example.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Public base URL of the gateway, used to build OAuth redirect URIs
# (for example https://mail.example.com). No trailing slash needed.
PUBLIC_BASE_URL=http://localhost:3000

# Comma-separated extra OAuth redirect URIs for MCP clients. Claude and the
# ChatGPT connector callbacks are accepted even if omitted here.
# MCP_OAUTH_REDIRECT_ALLOWLIST=https://claude.ai/api/mcp/auth_callback,https://chatgpt.com/connector_platform_oauth_redirect

# Google OAuth client (Google Cloud console, "Web application" type).
# Leave these empty to boot without the Google connect routes.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# HMAC secret for the OAuth state parameter; any random string of 16+ characters.
OAUTH_STATE_SECRET=
# Password of the admin dashboard and of the mailbox connect flow (HTTP Basic,
# any username). Leave empty to disable /admin and the connect routes. Use 16+
# characters: shorter values still boot but log a warning and show a red banner.
ADMIN_DASHBOARD_SECRET=

# Microsoft Entra ID application (multi-tenant). Leave these three empty to
# boot without the Microsoft connect routes. MICROSOFT_TENANT_ID is the default
# tenant for Microsoft mailboxes that have no tenant of their own.
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Zoho API console client ("Server-based Application"). Leave the two values
# empty to boot without the Zoho connect routes. ZOHO_REGION selects the Zoho
# datacenter (eu or com): a token minted on accounts.zoho.eu only works against
# mail.zoho.eu, so it must match where the Zoho accounts were created.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REGION=eu

# Optional Sentry DSN: unhandled server errors are reported with their correlation id
# only (no request bodies, headers, cookies or query strings). Leave empty to disable.
SENTRY_DSN=

# IANA time zone of the "On <date> <sender> wrote:" line that reply drafts quote
# below the body (for example Europe/London). Defaults to UTC.
GATEWAY_TIME_ZONE=UTC

# Mailbox registry read by `pnpm db:seed` only (never by the running gateway).
# Relative paths are read from the repository root. Copy mailboxes.example.json
# to mailboxes.json and edit it; see docs/CONFIGURATION.md. If the default file
# is missing, the seed skips mailboxes and you can add them from /admin.
# MAILBOXES_FILE=./mailboxes.json

# Bootstrap MCP client created by `pnpm db:seed`; use different credentials in
# each environment. Only clients listed in MCP_CLIENT_ALLOWLIST may connect
# with HTTP Basic credentials (OAuth clients are approved on /authorize).
MCP_CLIENT_ID=local-development-client
MCP_CLIENT_SECRET=replace-with-at-least-16-random-characters
MCP_CLIENT_ALLOWLIST=local-development-client
# Requests per window per MCP client on /mcp.
MCP_RATE_LIMIT_MAX=100
MCP_RATE_LIMIT_WINDOW_MS=60000
# true blocks every MCP tool call. The dashboard kill switch does the same at runtime.
GLOBAL_KILL_SWITCH=false

# AES-256-GCM keyring for stored OAuth tokens: JSON map of a positive version to
# a 32-byte base64 key. The sample is intentionally non-secret and MUST be
# replaced outside local development (for example: openssl rand -base64 32).
TOKEN_ENCRYPTION_CURRENT_VERSION=1
TOKEN_ENCRYPTION_KEYS={"1":"AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="}

# Feature flags. Set SEND_EMAILS=false as a delivery-only emergency stop.
# The received-message mutation capabilities must stay false.
READ_EMAILS=true
SEARCH_EMAILS=true
READ_THREADS=true
CREATE_DRAFTS=true
CREATE_REPLY_DRAFTS=true
UPDATE_DRAFTS=true
DELETE_GATEWAY_DRAFTS=true
SEND_EMAILS=true
DELETE_RECEIVED_MESSAGES=false
MOVE_MESSAGES=false
MODIFY_RECEIVED_MESSAGES=false
DOWNLOAD_ATTACHMENTS=false
