{
  "name": "@yempik/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./schema": "./dist/schema.js"
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -b tsconfig.json --pretty false",
    "lint": "eslint src",
    "test": "vitest run --root ../.. --passWithNoTests tests/unit/database.foundation.test.ts tests/unit/database.mailbox-registry.test.ts tests/integration/database.migrations.test.ts",
    "migrate": "tsx src/migrate.ts",
    "seed": "tsx src/seed.ts"
  },
  "dependencies": {
    "@yempik/core": "workspace:*",
    "@yempik/security": "workspace:*",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15"
  }
}
